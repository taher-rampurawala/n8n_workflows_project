                                         "specifyBody":  "json",
                                         "jsonBody":  "={{\n{\n  systemInstruction: {\n    parts: [\n      {\n        text: \"You are an OCR document extraction engine. Your only job is to extract structured data and return a single valid JSON object. Never return Markdown, code fences, explanations, comments, or additional text.\"\n      }\n    ]\n  },\n  contents: [\n    {\n      parts: [\n        {\n          text: `Extract the information from the attached invoice or receipt.\n\nRules:\n- Read only information visible in the document.\n- Do not guess or infer missing values.\n- If a value is missing, use JSON null.\n- Convert dates to YYYY-MM-DD.\n- Return monetary values as JSON numbers without currency symbols.\n- Sum all taxes into total_tax.\n- Choose the best CRA expense category.\n- The response MUST start with { and end with }.\n- Return exactly one valid JSON object.\n\nRequired fields:\n- date\n- invoice_number\n- supplier_name\n- supplier_tax_id\n- buyer_name\n- cra_expense_category\n- description_summary\n- subtotal\n- total_tax\n- total_paid\n- payment_method\n- payment_reference`\n        },\n        {\n          inlineData: {\n            mimeType: $(\u0027Download file\u0027).item.json.mimeType,\n            data: $json.data\n          }\n        }\n      ]\n    }\n  ],\n  generationConfig: {\n    temperature: 0,\n    responseMimeType: \"application/json\",\n    responseSchema: {\n      type: \"OBJECT\",\n      properties: {\n        date: { type: \"STRING\", nullable: true },\n        invoice_number: { type: \"STRING\", nullable: true },\n        supplier_name: { type: \"STRING\", nullable: true },\n        supplier_tax_id: { type: \"STRING\", nullable: true },\n        buyer_name: { type: \"STRING\", nullable: true },\n        cra_expense_category: { type: \"STRING\", nullable: true },\n        description_summary: { type: \"STRING\", nullable: true },\n        subtotal: { type: \"NUMBER\", nullable: true },\n        total_tax: { type: \"NUMBER\", nullable: true },\n        total_paid: { type: \"NUMBER\", nullable: true },\n        payment_method: { type: \"STRING\", nullable: true },\n        payment_reference: { type: \"STRING\", nullable: true }\n      },\n      required: [\n        \"date\",\n        \"invoice_number\",\n        \"supplier_name\",\n        \"supplier_tax_id\",\n        \"buyer_name\",\n        \"cra_expense_category\",\n        \"description_summary\",\n        \"subtotal\",\n        \"total_tax\",\n        \"total_paid\",\n        \"payment_method\",\n        \"payment_reference\"\n      ]\n    }\n  }\n}\n}}",
                                         "options":  {

                                                     }
                                     },
