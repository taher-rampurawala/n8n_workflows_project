    {
      "parameters": {
        "jsCode": "// Generate Proposal emits one item per input, in order, so index i matches the i-th qualifying job.\nconst jobs = $('Filter Qualifying Jobs').all();\n\nreturn $input.all().map((item, i) => {\n  const proposal = item.json.text ?? '';\n  return {\n    json: {\n      ...jobs[i].json,\n      proposal,\n      status: proposal ? 'Pending Review' : 'Proposal failed',\n    },\n  };\n});"
      },
